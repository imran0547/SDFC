<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Signal Cards</masterLabel>
    <description>Shows the configured signals for an Account or Opportunity, with pre-filled actions the user saves.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Account</object>
                <object>Opportunity</object>
            </objects>
            <property name="cardTitle" type="String" label="Card title" default="Signals"/>
            <property name="agent" type="String" label="Agent" datasource="Insight,Next Best Action" description="Show only one agent's signals, or leave blank for both."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
